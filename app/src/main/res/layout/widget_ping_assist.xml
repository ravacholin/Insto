<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:id="@+id/widget_open_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="PingAssist"
            android:textColor="#10D98B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_contact_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Set Contact"
            android:textColor="#F1F7F5"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_btn_open_chat"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_btn_chat"
        android:contentDescription="@string/shortcut_open_chat_long"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_chat_bubble" />

    <ImageButton
        android:id="@+id/widget_btn_voice_note"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_btn_mic"
        android:contentDescription="@string/shortcut_voice_long"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_mic_pulse" />
</LinearLayout>
